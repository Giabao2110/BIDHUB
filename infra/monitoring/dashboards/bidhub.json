{
  "uid": "bidhub-operations", "title": "BIDHUB — API operations", "schemaVersion": 39,
  "version": 1, "refresh": "15s", "timezone": "browser", "time": {"from":"now-1h","to":"now"},
  "tags": ["bidhub", "lab"],
  "panels": [
    {"id":1,"type":"timeseries","title":"API requests per second","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"bidhub-prometheus"},"targets":[{"refId":"A","expr":"sum(rate(bidhub_http_duration_seconds_count[5m]))","legendFormat":"Requests/s"}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]}},
    {"id":2,"type":"timeseries","title":"API completed request p95 (seconds)","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"bidhub-prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by(le) (rate(bidhub_http_duration_seconds_bucket[5m])))","legendFormat":"p95"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":3,"type":"timeseries","title":"Node process resident memory (bytes)","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"bidhub-prometheus"},"targets":[{"refId":"A","expr":"bidhub_process_resident_memory_bytes","legendFormat":"RSS"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"id":4,"type":"timeseries","title":"Node process CPU (cores)","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"bidhub-prometheus"},"targets":[{"refId":"A","expr":"rate(bidhub_process_cpu_seconds_total[5m])","legendFormat":"CPU cores"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"id":5,"type":"timeseries","title":"Socket.IO current connections","gridPos":{"x":0,"y":16,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"bidhub-prometheus"},"targets":[{"refId":"A","expr":"bidhub_socket_connections","legendFormat":"Connections"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"id":6,"type":"timeseries","title":"PostgreSQL pool counts","gridPos":{"x":12,"y":16,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"bidhub-prometheus"},"targets":[{"refId":"A","expr":"bidhub_db_pool_connections","legendFormat":"{{state}}"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"id":7,"type":"timeseries","title":"Scheduler batch failures in 5 minutes","gridPos":{"x":0,"y":24,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"bidhub-prometheus"},"targets":[{"refId":"A","expr":"increase(bidhub_lifecycle_runs_total{result=\"failure\"}[5m])","legendFormat":"Failed batches"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"id":8,"type":"timeseries","title":"API 5xx responses per second","gridPos":{"x":12,"y":24,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"bidhub-prometheus"},"targets":[{"refId":"A","expr":"sum(rate(bidhub_http_duration_seconds_count{status=~\"5..\"}[5m]))","legendFormat":"5xx/s"}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]}}
  ]
}

# Install in host Nginx, replace bidhub.example.com and provision real certificates first.
server {
  listen 80;
  server_name bidhub.example.com;
  return 301 https://$host$request_uri;
}
server {
  listen 443 ssl;
  server_name bidhub.example.com;
  ssl_certificate /etc/letsencrypt/live/bidhub.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/bidhub.example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 64k;
  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 75s;
  }
}
